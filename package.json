{
  "name": "zyl-next",
  "version": "10.2.6",
  "description": "Zyl is a Next.js server structure generator and CLI inspired by NestJS and Angular modular structure.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "zyl": "./dist/bin/zyl.js"
  },
  "files": [
    "scripts",
    "dist",
    "templates"
  ],
  "scripts": {
    "watch": "zyl watch",
    "dev": "concurrently \"zyl watch\" \"next dev\"",
    "watch:routes": "node dist/lib/watcher/index.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    "./wrapHandler": "./dist/lib/wrapHandler.js",
    "./WrappedRequest": "./dist/lib/wrapHandler.js"
  },
  "dependencies": {
    "chalk": "5",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "debounce": "^3.0.0",
    "fs-extra": "^11.2.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "yup": ">=1",
    "zyl-next": "^10.2.5"
  },
  "devDependencies": {
    "@types/chalk": "^2.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/next": "^9.0.0",
    "@types/node": "^24.7.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}