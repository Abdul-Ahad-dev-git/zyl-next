{
  "name": "zyl-next",
  "version": "10.1.5",
  "description": "Zyl is a Next.js server structure generator and CLI inspired by NestJS and Angular modular structure.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "zyl": "./bin/zyl.js"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "dist"
  ],
  "scripts": {
    "watch:routes": "node scripts/watch-routes.js",
    "watch": "zyl watch",
    "dev": "concurrently \"zyl watch\" \"next dev\""
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./wrapHandler": "./dist/wrapHandler.js",
    "./WrappedRequest": "./dist/wrapHandler.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "concurrently": "^8.2.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/chalk": "^2.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/next": "^9.0.0",
    "@types/node": "^24.7.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18",
    "yup": ">=1"

  },
  "publishConfig": {
    "access": "public"
  }
}